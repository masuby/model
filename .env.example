# INFORM Tanzania Platform - Environment Variables
# Copy this file to .env and update with your settings

# =============================================================================
# PRODUCTION SETTINGS (inform.co.tz)
# =============================================================================

# Go Backend API URL
VITE_API_URL=https://api.inform.co.tz/api/v1

# Supabase Configuration (for real-time updates and data persistence)
# REQUIRED for production: these are inlined by Vite AT BUILD TIME, so they
# must be set in the hosting dashboard (Netlify/Vercel) BEFORE the build runs.
# If missing, the app degrades gracefully (Supabase features disabled) but will
# NOT crash. Trigger a fresh build (clear cache) after setting these.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# DEVELOPMENT SETTINGS (localhost)
# =============================================================================
# Uncomment these for local development:
# VITE_API_URL=http://localhost:8080/api/v1
# Or leave VITE_API_URL empty to use Vite proxy
