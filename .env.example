# INFORM Tanzania - environment variables (copy to .env.local for development).
# Vite inlines VITE_* values at BUILD time: set them in the Vercel project settings before building.

# Supabase (optional). When both are set, the Data portal uses the shared database with sign-in,
# roles and an approval queue. When they are absent the app runs in "demo mode": edits stay in the
# visitor's browser only. The key is the PUBLIC anon/publishable key - never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
